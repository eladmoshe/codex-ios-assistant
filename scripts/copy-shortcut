#!/bin/zsh
set -euo pipefail

readonly repo_dir="${0:A:h:h}"
readonly python_bin="$repo_dir/.venv/bin/python"

if [[ ! -x "$python_bin" ]]; then
  print -u2 "Run ./scripts/install first."
  exit 1
fi

actions="$($python_bin "$repo_dir/scripts/render-shortcut.py")"
/usr/bin/swift "$repo_dir/scripts/copy-shortcut-actions.swift" "$actions"
print "Fresh install: open Shortcuts, create a blank shortcut named iOS Assistant,"
print "click its action canvas, and press Command-V once; then let iCloud sync it."
print "Existing install: open the stable iOS Assistant shortcut, delete all actions,"
print "and press Command-V once in place so its Message automation target is preserved."
