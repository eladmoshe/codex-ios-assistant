# The iMessage address or phone number that this Mac uses to message your iPhone.
IPHONE_MSG_TARGET="you@example.com"

# Stable HTTPS origin routed by Cloudflare Tunnel to 127.0.0.1:8787.
IPHONE_PUBLIC_URL="https://iphone.example.com"

# Generate this with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
IPHONE_RECEIVER_TOKEN="replace-with-at-least-32-random-characters"

# Optional private receiver registration socket (defaults to a per-user path in /tmp).
# IPHONE_REGISTRATION_SOCKET="/tmp/codex-ios-assistant-receiver-501.sock"
