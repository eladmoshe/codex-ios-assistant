#!/usr/bin/env python3
"""Install and start the per-user sender, receiver, and tunnel LaunchAgents."""

from __future__ import annotations

import os
from pathlib import Path
import plistlib
import pwd
import shutil
import subprocess


REPO = Path(__file__).resolve().parents[1]
VENV = REPO / ".venv"
PYTHON = VENV / "bin" / "python"
CONFIG_DIR = Path.home() / ".config" / "codex-ios-assistant"
CONFIG_FILE = CONFIG_DIR / "config.env"
TUNNEL_CONFIG = CONFIG_DIR / "cloudflared.yml"
LOG_DIR = Path.home() / "Library" / "Logs" / "codex-ios-assistant"
AGENT_DIR = Path.home() / "Library" / "LaunchAgents"
DOMAIN = f"gui/{os.getuid()}"
ACCOUNT = pwd.getpwuid(os.getuid())
FILE_BACKED_ENVIRONMENT = {
    "HOME": ACCOUNT.pw_dir,
    "USER": ACCOUNT.pw_name,
    "LOGNAME": ACCOUNT.pw_name,
    "PATH": "/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin",
}


def launchagent_validation_environment() -> dict[str, str]:
    """Match the file-backed config environment used by generated jobs."""
    return dict(FILE_BACKED_ENVIRONMENT)


def file_backed_python(module: str) -> list[str]:
    """Run a service without inheriting shell or launchd-manager overrides."""
    assignments = [f"{name}={value}" for name, value in FILE_BACKED_ENVIRONMENT.items()]
    return ["/usr/bin/env", "-i", *assignments, str(PYTHON), "-m", module]


def plist(label: str, arguments: list[str], log_name: str) -> dict[str, object]:
    return {
        "Label": label,
        "ProgramArguments": arguments,
        "RunAtLoad": True,
        "KeepAlive": True,
        "ProcessType": "Background",
        "ThrottleInterval": 10,
        "StandardOutPath": str(LOG_DIR / f"{log_name}.log"),
        "StandardErrorPath": str(LOG_DIR / f"{log_name}.log"),
    }


def install(label: str, value: dict[str, object]) -> None:
    path = AGENT_DIR / f"{label}.plist"
    temporary = path.with_suffix(".plist.tmp")
    with temporary.open("wb") as output:
        plistlib.dump(value, output, fmt=plistlib.FMT_XML, sort_keys=False)
    os.replace(temporary, path)
    subprocess.run(["launchctl", "bootout", DOMAIN, str(path)], check=False, capture_output=True)
    subprocess.run(["launchctl", "bootstrap", DOMAIN, str(path)], check=True)
    subprocess.run(["launchctl", "kickstart", "-k", f"{DOMAIN}/{label}"], check=True)
    print(f"Installed and started {label}")


def main() -> int:
    if not PYTHON.is_file():
        raise SystemExit("Run ./scripts/install first.")
    if not CONFIG_FILE.is_file():
        raise SystemExit("Run ./scripts/configure first.")
    validation = subprocess.run(
        [
            str(PYTHON),
            "-c",
            "from iphone_cli.config import validate_runtime_config; validate_runtime_config()",
        ],
        capture_output=True,
        text=True,
        check=False,
        env=launchagent_validation_environment(),
    )
    if validation.returncode != 0:
        raise SystemExit(
            "Private config is incomplete or invalid; "
            "run ./scripts/configure --non-interactive first."
        )
    LOG_DIR.mkdir(parents=True, exist_ok=True)
    LOG_DIR.chmod(0o700)
    AGENT_DIR.mkdir(parents=True, exist_ok=True)

    install(
        "io.github.codex-ios-assistant.sender",
        plist(
            "io.github.codex-ios-assistant.sender",
            [*file_backed_python("iphone_cli.bridge"), "sender"],
            "sender",
        ),
    )
    install(
        "io.github.codex-ios-assistant.receiver",
        plist(
            "io.github.codex-ios-assistant.receiver",
            file_backed_python("iphone_cli.receiver"),
            "receiver",
        ),
    )

    if TUNNEL_CONFIG.is_file():
        cloudflared = shutil.which("cloudflared")
        if not cloudflared:
            raise SystemExit("cloudflared is missing. Install it with: brew install cloudflared")
        install(
            "io.github.codex-ios-assistant.tunnel",
            plist(
                "io.github.codex-ios-assistant.tunnel",
                [cloudflared, "tunnel", "--config", str(TUNNEL_CONFIG), "run"],
                "tunnel",
            ),
        )
    else:
        print("Tunnel service skipped; run ./scripts/setup-cloudflare, then rerun this script.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
